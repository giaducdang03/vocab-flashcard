# Copy to .env and fill in real values. Never commit .env.

# Database
POSTGRES_USER=vocabflash
POSTGRES_PASSWORD=
POSTGRES_DB=vocabflash

# Backend auth
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Comma-separated emails that are always admins (promoted on register/login)
ADMIN_EMAILS=

# AI quiz generation (leave AI_API_KEY empty to disable AI features)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Default AI quizzes per user per rolling 24h; admins can override per user
AI_DAILY_QUIZ_LIMIT=20

# Google OAuth (leave empty to disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
FRONTEND_URL=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3000/api
